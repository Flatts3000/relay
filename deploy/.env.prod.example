# Production environment configuration
# Copy to .env.prod and fill in real values
# NEVER commit .env.prod to version control

# Node
NODE_ENV=production
PORT=4000

# Database (credentials for the postgres container)
DB_USER=relay
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
DB_NAME=relay

# Application URLs
# Reverse proxy hops in front of the backend. Caddy is the only one.
# Leave unset (0) anywhere the backend is reachable directly.
TRUST_PROXY_HOPS=1

# Requests per 15 minutes to /api/auth/login and to /api/auth/verify,
# counted separately. Optional; defaults to 10. Leave unset rather than
# blank - an empty value falls back to the default, but a zero would be
# rejected at boot.
# AUTH_LOGIN_RATE_LIMIT_MAX=10

CORS_ORIGIN=https://relayfunds.org
FRONTEND_URL=https://relayfunds.org

# Email (Resend free tier: 100/day, 3,000/month)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxx
EMAIL_FROM_ADDRESS=noreply@relayfunds.org
EMAIL_FROM_NAME=Relay

# Staff Admin (comma-separated emails)
STAFF_ADMIN_EMAILS=flatts.scg@gmail.com

# AWS (for database backups to S3)
#
# No access keys here. The instance carries an IAM role (relay-prod-ssm) that
# grants exactly the S3 permissions the backup job needs on this one bucket, so
# the AWS CLI picks credentials up automatically and there is no long-lived
# secret on the host to leak or rotate.
AWS_DEFAULT_REGION=us-east-1
S3_BACKUP_BUCKET=relay-backups-prod
